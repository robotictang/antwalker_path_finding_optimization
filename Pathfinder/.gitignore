# Generated review bundles duplicate the manuscripts, code and study records.
# Keep local copies; regenerate them when preparing a review handoff.
/publication_*/IJ3C_Review_Bundle.zip
/outputs/ieee_access_final/Hexapod_Final_V6_Package.zip
/outputs/ieee_access_validation/Hexapod_Validated_Review_Package.zip
/paper/review_package.zip

# Locally installed third-party document-rendering dependencies.
/outputs/word_guide_deps/
/outputs/hexapod_journal/deps/
/outputs/render_compat/glibc/
/outputs/render_compat/libc6.deb
**/qa/render_runtime/
**/qa/runtime/font_cache/

# Mutable browser/publication demo history; experiment databases stay versioned.
/workbench/mujoco/outputs/browser_demo_history.sqlite3*
/workbench/mujoco/outputs/publication_demo_history.sqlite3*

# Intermediate page renders and working document copies. Final manuscripts,
# publication figures, numerical QA reports and all raw evidence remain tracked.
**/qa/**/*.png
**/qa/**/*.jpg
**/qa/**/*.jpeg
**/qa/**/*.gif
**/qa/**/*.pdf
**/qa/**/*.docx
