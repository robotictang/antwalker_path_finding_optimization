<?xml version="1.0" encoding="utf-8"?>
<!-- =================================================================================== -->
<!-- Hexapod Robot URDF Asset for NVIDIA Isaac Lab / Isaac Sim                           -->
<!-- Exported directly from Autodesk Fusion 360 Assembly                                -->
<!-- Total DOFs: 18 (3 DOFs x 6 Legs: Hip Yaw, Femur Pitch, Tibia Pitch)                 -->
<!-- Actuators: RS04 High-Torque Brushless Motors (60 Nm peak torque, 20 rad/s)         -->
<!-- =================================================================================== -->
<robot name="hexapod">

  <!-- ======================== BASE LINK / CHASSIS ======================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="35.0"/>
      <inertia ixx="2.14" ixy="0.0" ixz="0.0" iyy="2.24" iyz="0.0" izz="4.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="chassis_grey">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>
    <!-- Grand Elevated Ant Carapace Top Cover (More Bigger & More Upper with Side Pockets & Battery Box) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/top_cover.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="carapace_carbon">
        <color rgba="0.13 0.14 0.16 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.84 0.60 0.28"/>
      </geometry>
    </collision>
  </link>

  <!-- ===================================================================== -->
  <!-- LEFT LEGS (LF: Front, LM: Mid, LR: Rear)                              -->
  <!-- ===================================================================== -->

  <!-- -------------------- LEFT FRONT (LF) -------------------- -->
  <joint name="LF_hip_joint" type="revolute">
    <origin xyz="0.320 0.410 0.1085" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="LF_coxa"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="60.0" velocity="20.0"/>
    <dynamics damping="1.5" friction="0.1"/>
  </joint>

  <link name="LF_coxa">
    <inertial>
      <origin xyz="0 0.078 0.0" rpy="0 0 0"/>
      <mass value="2.02"/>
      <inertia ixx="0.009" ixy="0" ixz="0" iyy="0.007" iyz="0" izz="0.012"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/coxa_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="accent_orange">
        <color rgba="0.85 0.45 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.078 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.18 0.12"/>
      </geometry>
    </collision>
  </link>

  <joint name="LF_femur_joint" type="revolute">
    <origin xyz="0 0.157 0" rpy="0 0 0"/>
    <parent link="LF_coxa"/>
    <child link="LF_femur"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.047" upper="1.047" effort="60.0" velocity="20.0"/>
    <dynamics damping="2.0" friction="0.1"/>
  </joint>

  <link name="LF_femur">
    <inertial>
      <origin xyz="0 0.350 0.0" rpy="0 0 0"/>
      <mass value="3.49"/>
      <inertia ixx="0.018" ixy="0" ixz="0" iyy="0.082" iyz="0" izz="0.085"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/femur_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="link_grey">
        <color rgba="0.3 0.3 0.32 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.350 0.0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.70"/>
      </geometry>
    </collision>
  </link>

  <joint name="LF_tibia_joint" type="revolute">
    <origin xyz="0 0.700 0" rpy="0 0 0"/>
    <parent link="LF_femur"/>
    <child link="LF_tibia"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.094" upper="0.349" effort="60.0" velocity="20.0"/>
    <dynamics damping="2.0" friction="0.1"/>
  </joint>

  <link name="LF_tibia">
    <inertial>
      <origin xyz="0 0.380 0.0" rpy="0 0 0"/>
      <mass value="4.71"/>
      <inertia ixx="0.215" ixy="0" ixz="0" iyy="0.218" iyz="0" izz="0.015"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/tibia_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="link_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0.380 0.0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.76"/>
      </geometry>
    </collision>
  </link>

  <joint name="LF_foot_joint" type="fixed">
    <origin xyz="0 0.764 0" rpy="0 0 0"/>
    <parent link="LF_tibia"/>
    <child link="LF_foot"/>
  </joint>

  <link name="LF_foot">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
    </collision>
  </link>

